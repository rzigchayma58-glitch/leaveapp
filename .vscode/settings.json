{
  "dart.flutterSdkPath": null,
  "dart.debugExternalPackageLibraries": false,
  "dart.debugSdkLibraries": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/build/": true,
    "**/.dart_tool/": true
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "dart.lineLength": 120
}